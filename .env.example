# ─── Citrafoam Production Environment Variables ───

# 1. Database (PostgreSQL from Neon.tech, Supabase, or Vercel Postgres)
# Replace with your connection string:
DATABASE_URL="postgresql://<username>:<password>@<host>/<database>?sslmode=require"

# 2. NextAuth.js Authentication
# In production, NEXTAUTH_URL should be your live domain (e.g., https://citrafoam.vercel.app)
NEXTAUTH_URL="https://your-production-domain.com"
# Generate a random 32-byte secret (e.g., `openssl rand -base64 32` or random string)
NEXTAUTH_SECRET="your-production-secret-key-at-least-32-chars"
AUTH_SECRET="your-production-secret-key-at-least-32-chars"
AUTH_TRUST_HOST="true"

# 3. Google OAuth (Optional - leave blank if not using Google login)
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# 4. Stripe Payments (Optional - use test or live keys)
STRIPE_SECRET_KEY="sk_test_..."
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."

# 5. Public Application URLs
NEXT_PUBLIC_APP_URL="https://your-production-domain.com"
NEXT_PUBLIC_APP_NAME="Citrafoam"
